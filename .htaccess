RewriteEngine On

# --- HTTPS اجباری (SSL رایگان هاست را فعال کنید) ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- حذف www در صورت تمایل (اختیاری - در صورت نیاز فعال کنید) ---
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# --- مسیرهای واقعی فایل/پوشه مستقیم سرو شوند (assets, uploads, admin, install.php) ---
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- robots.txt و sitemap.xml پویا (بر اساس تنظیمات پنل ادمین) ---
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# --- بقیه درخواست‌ها به فرانت‌کنترلر فروشگاه ---
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# --- هدرهای امنیتی ---
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- غیرفعال کردن Directory Listing ---
Options -Indexes

# --- جلوگیری از نمایش فایل‌های حساس در صورت اشتباه در آپلود ---
<FilesMatch "\.(sql|log|md|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
