RewriteEngine On

# --- Force HTTPS (enable the host-provided SSL certificate first) ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Remove www if desired (optional; enable only when needed) ---
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# --- Serve real files/directories directly (assets, uploads, admin, install.php) ---
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- Dynamic robots.txt and sitemap.xml (controlled by admin settings) ---
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# --- Forward all other requests to the store front controller ---
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

# --- Security headers ---
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Disable directory listing ---
Options -Indexes

# --- Prevent exposure of sensitive files after accidental uploads ---
<FilesMatch "\.(sql|log|md|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
