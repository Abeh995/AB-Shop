{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Admin routes and parameters for the Playwright UI audit. IDs can be overridden via tools/ui-test/pages.local.json or AB_* environment variables.",
  "defaults": {
    "product_id": 1,
    "order_id": 1,
    "expense_id": 1,
    "gift_item_id": 1,
    "shipping_method_id": 1,
    "sms_pattern_id": 1,
    "theme_id": 1,
    "email_id": 1
