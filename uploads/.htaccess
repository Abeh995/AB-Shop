# Prevent PHP/script execution inside uploads (security)
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php[3-8]?|phtml|pl|py|cgi|asp|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI

# ── MIME types: Method 1 – mod_mime (AddType) ────────────────────────────
# Works when AllowOverride FileInfo is enabled.
<IfModule mod_mime.c>
    AddType image/webp  .webp
    AddType image/svg+xml .svg .svgz
    AddType image/jpeg  .jpg .jpeg
    AddType image/png   .png
</IfModule>

# ── MIME types: Method 2 – mod_headers (Header set) ─────────────────────
# Works on most shared hosts even when AllowOverride FileInfo is off.
<IfModule mod_headers.c>
    <FilesMatch "\.webp$">
        Header set Content-Type "image/webp"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg)$">
        Header set Content-Type "image/jpeg"
    </FilesMatch>
    <FilesMatch "\.png$">
        Header set Content-Type "image/png"
    </FilesMatch>
    <FilesMatch "\.svg$">
        Header set Content-Type "image/svg+xml"
    </FilesMatch>
</IfModule>

# ── MIME types: Method 3 – ForceType per extension ───────────────────────
# Additional fallback for hosts where AddType is blocked.
<FilesMatch "\.webp$">
    <IfModule mod_mime.c>
        ForceType image/webp
    </IfModule>
</FilesMatch>
